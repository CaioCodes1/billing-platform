# Copie para .env e ajuste. O .env nao vai para o git.
DB_URL=jdbc:postgresql://localhost:5433/billing
DB_USER=billing
DB_PASSWORD=billing

# Chave HS256 do JWT: minimo 32 bytes. Gere com:
#   openssl rand -base64 48
JWT_SECRET=troque-esta-chave-por-uma-gerada-aleatoriamente-com-no-minimo-32-bytes
JWT_ACCESS_TTL=PT15M
JWT_REFRESH_TTL=P7D

# Admin criado no primeiro boot se a tabela users estiver vazia.
BOOTSTRAP_ADMIN_EMAIL=admin@billing.local
BOOTSTRAP_ADMIN_PASSWORD=

MAIL_HOST=localhost
MAIL_PORT=1025
